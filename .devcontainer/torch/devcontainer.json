// JAX *and* PyTorch (CPU build), for running consistency_test.py and
// tests/qwen3vl_vision_parity.py against HuggingFace.
// Prefer .devcontainer/default/ for day-to-day work: torch is a large,
// test-only dependency and its CUDA build breaks JAX's cuDNN.
{
	"name": "fabrique + torch (consistency checks)",
	"build": {
		"context": "../..",
		"dockerfile": "../../Dockerfile",
		"target": "build-dev-torch"
	},

	"mounts": [
		"source=${localEnv:HOME}/.cache/,target=/home/devpod/.cache/,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude/,target=/home/devpod/.claude/,type=bind,consistency=cached",
		"source=${localEnv:HOME}/data/,target=/data/,type=bind,consistency=cached"
	],

	"containerEnv": {
		"PYTHONPATH": "src",
		"HF_TOKEN": "${localEnv:HF_TOKEN_PERSONAL}",
		"JAX_COMPILATION_CACHE_DIR": "/tmp/jax_cache",
		"XLA_PYTHON_CLIENT_MEM_FRACTION": ".95",
		"TF_GPU_ALLOCATOR": "cuda_malloc_async",  // mitigates fragmentation
		"XLA_FLAGS": "--xla_gpu_enable_command_buffer="
	},

	"customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ]
        }
    },

	"postCreateCommand": "bash .devcontainer/init.sh",

	"runArgs": ["--gpus", "all", "--shm-size", "2g"]

}