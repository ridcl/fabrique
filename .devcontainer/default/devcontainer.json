// Default environment: JAX only. Use this unless you are running
// cross-framework consistency checks -- see .devcontainer/torch/ for that.
{
	"name": "fabrique",
	"build": {
		"context": "../..",
		"dockerfile": "../../Dockerfile",
		"target": "build-dev"
	},

	"mounts": [
		"source=${localEnv:HOME}/.cache/,target=/home/devpod/.cache/,type=bind,consistency=cached",
		"source=${localEnv:HOME}/.claude/,target=/home/devpod/.claude/,type=bind,consistency=cached",
		"source=${localEnv:HOME}/data/,target=/data/,type=bind,consistency=cached"
	],

	"containerEnv": {
		"PYTHONPATH": "src",
		"HF_TOKEN": "${localEnv:HF_TOKEN_PERSONAL}",
		"JAX_COMPILATION_CACHE_DIR": "/tmp/jax_cache",
		"XLA_PYTHON_CLIENT_MEM_FRACTION": ".95",
		"TF_GPU_ALLOCATOR": "cuda_malloc_async",  // mitigates fragmentation
		"XLA_FLAGS": "--xla_gpu_enable_command_buffer="
	},

	// Talks to the HOST docker daemon. The feature mounts the host socket to
	// /var/run/docker-host.sock and puts a socat proxy on /var/run/docker.sock
	// owned by the container user -- do NOT also bind-mount the host socket
	// onto /var/run/docker.sock, that collides with the proxy and reintroduces
	// the group-ownership problem the feature exists to solve.
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
	},

	"customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python"
            ]
        }
    },

	"postCreateCommand": "bash .devcontainer/init.sh",

	"runArgs": ["--gpus", "all", "--shm-size", "2g"]

}